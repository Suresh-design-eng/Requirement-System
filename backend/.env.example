DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=generate-a-long-random-secret-outside-source-control
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=local

# Set only for the one-time `python -m app.scripts.create_admin` command.
# Do not leave INITIAL_ADMIN_PASSWORD configured on the web service afterwards.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
